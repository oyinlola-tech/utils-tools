{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/about",
      "destination": "/pages/about.html"
    },
    {
      "source": "/tools",
      "destination": "/pages/tools.html"
    },
    {
      "source": "/tools/:tool([a-z0-9][a-z0-9-]*)",
      "destination": "/pages/:tool.html"
    },
    {
      "source": "/errors/:name([a-z0-9-]+)",
      "destination": "/errors/:name.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tools.telente.site/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://tools.telente.site/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://tools.telente.site/robots.txt"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
