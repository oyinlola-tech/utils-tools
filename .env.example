APP_NAME=Utils-tool
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_SIZE_MB=100

STORAGE_DRIVER=local

UPLOAD_DIRECTORY=storage/uploads
PROCESSED_DIRECTORY=storage/processed
COMPRESSED_DIRECTORY=storage/compressed
TEMP_DIRECTORY=storage/temp

JOB_TTL_MINUTES=30

# Rate limiting (enforced in production only)
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Vercel only
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Access mode of the connected Blob store: "public" (default) or "private"
BLOB_ACCESS_MODE=public

# Rate limits per client (enforced in production only); see DEPLOYMENT.md
RATE_LIMIT_READ_MAX_REQUESTS=600
RATE_LIMIT_TRANSFER_MAX_REQUESTS=600
RATE_LIMIT_HEAVY_MAX_REQUESTS=20
RATE_LIMIT_HEAVY_HOURLY_REQUESTS=200
# Only when a reverse proxy sets it, e.g. x-forwarded-for
TRUSTED_PROXY_HEADER=

# Optional, for video sites that refuse server addresses
VIDEO_COOKIES_FILE=
VIDEO_PROXY=
